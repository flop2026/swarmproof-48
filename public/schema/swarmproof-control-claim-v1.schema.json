{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarmproof-48-e463.pages.dev/schema/swarmproof-control-claim-v1.schema.json",
  "title": "SwarmProof project resource control claim v1",
  "description": "A project-specific, domain-separated Ed25519 claim. Runtime verification additionally requires canonical JSON bytes, exact validity semantics, and the Ed25519 signature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "proof"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project",
        "purpose",
        "controller",
        "issued_at",
        "expires_at",
        "resources"
      ],
      "properties": {
        "schema": { "const": "swarmproof-control-claim-v1" },
        "project": { "const": "swarmproof-48-e463" },
        "purpose": { "const": "project-resource-binding" },
        "controller": {
          "const": "did:key:z6MkqNyQTuVH8ZqJc5HZ2M9FGDDWBmVupBrX96G3EA3J5gSw"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "resources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "uri"],
              "properties": {
                "type": { "const": "github-repository" },
                "uri": { "const": "https://github.com/flop2026/swarmproof-48" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "uri"],
              "properties": {
                "type": { "const": "https-origin" },
                "uri": { "const": "https://swarmproof-48-e463.pages.dev" }
              }
            }
          ],
          "items": false
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "encoding", "value"],
      "properties": {
        "type": { "const": "Ed25519" },
        "encoding": { "const": "base64url" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
